# AfroBank Ledger - Local Environment Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
POSTGRES_DB=afrobank_ledger
POSTGRES_USER=afrobank
POSTGRES_PASSWORD=afrobank_secret
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
